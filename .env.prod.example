# Production settings for docker-compose.prod.yml. Copy to `.env` (next to the compose file) and
# fill in every value. Never commit the real `.env`.
#
# Generate each secret with:  openssl rand -hex 32
# (hex keeps them URL-safe, which matters because POSTGRES_PASSWORD goes into a connection URL)

# Public hostname of the dispatcher dashboard + API. Its DNS A/AAAA record must point at this server.
DOMAIN=dispatch.example.com

# Let's Encrypt registration / expiry notices for the HTTPS certificate.
ACME_EMAIL=ops@example.com

# PostgreSQL password for the `proofdrop` user.
POSTGRES_PASSWORD=

# Signs login tokens (at least 16 characters; use 64 hex characters). Changing it signs everyone out.
JWT_SECRET=

# MinIO root credentials, also used by the API to store evidence photos.
S3_ACCESS_KEY=proofdrop
S3_SECRET_KEY=
