# Copy to .env for local development (`npm run start:dev`).
PORT=3000
DATABASE_URL=postgresql://proofdrop:proofdrop@localhost:5433/proofdrop?schema=public
JWT_SECRET=change-me-to-a-long-random-string

# local = files under UPLOAD_DIR; s3 = any S3-compatible store (MinIO in docker compose, AWS S3, Cloudflare R2)
STORAGE_DRIVER=s3
UPLOAD_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=proofdrop
S3_SECRET_KEY=proofdrop-secret
S3_BUCKET=evidence

# Swagger UI at /api/docs (true for local development; keep false in production)
SWAGGER_ENABLED=true

# Reverse-proxy hops in front of the API (0 when the API is hit directly, as with npm run start:dev)
TRUST_PROXY=0

# Optional: comma-separated browser origins allowed by CORS (unset = any origin; fine for dev)
# CORS_ORIGINS=https://dispatch.example.com
